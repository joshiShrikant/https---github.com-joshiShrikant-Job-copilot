# ==============================================================================
# EuroJob Copilot - Environment Configuration Template
# Copy this file to .env (`cp .env.example .env`) and configure values.
# Never commit .env or real secrets to source control.
# ==============================================================================

# Application Profile (local, dev, test, prod)
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
FRONTEND_PORT=4200
BACKEND_BIND_IP=127.0.0.1
FRONTEND_BIND_IP=127.0.0.1

# MySQL Container & Database Settings
MYSQL_EXTERNAL_PORT=3307
DB_HOST=mysql
DB_PORT=3306
DB_NAME=eurojob_copilot
MYSQL_DATABASE=eurojob_copilot
MYSQL_USER=eurojob_user
MYSQL_PASSWORD=replace_with_secure_db_password
MYSQL_ROOT_PASSWORD=replace_with_secure_root_password

# Spring Boot DataSource Override
# Note: Use useSSL=true and a managed TLS CA when connecting to an external managed MySQL host.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/eurojob_copilot?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=eurojob_user
SPRING_DATASOURCE_PASSWORD=replace_with_secure_db_password

# Liquibase Migrations
LIQUIBASE_ENABLED=true

# Security, JWT & Refresh Cookies
# Generate a strong secret for prod: openssl rand -base64 48
JWT_SECRET=replace-with-a-256-bit-secret-key-at-least-32-chars-long
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800
JWT_ISSUER=eurojob-copilot
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# HTTP Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_AI_MAX_REQUESTS=30
RATE_LIMIT_API_MAX_REQUESTS=180
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false

# Resume Document Storage
RESUME_STORAGE_PATH=/var/lib/eurojob-copilot/resumes
RESUME_MAX_FILE_SIZE_BYTES=10485760

# Scheduling & Job Ingestion Providers
APP_SCHEDULING_ENABLED=true
JOB_INGESTION_ENABLED=true
JOB_INGESTION_SCHEDULER_ENABLED=true
JOB_INGESTION_CRON=0 0 */6 * * *
JOB_STALE_EXPIRATION_CRON=0 30 2 * * *
ARBEITNOW_ENABLED=true
ADZUNA_ENABLED=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_ENABLED=true
JOOBLE_BASE_URL=https://jooble.org/api
JOOBLE_API_KEY=
JOOBLE_COUNTRY_CODES=de,nl,gb,ch
JOOBLE_LOCATIONS=

# Netherlands IND Official Sponsor Register Sync
IND_SPONSOR_SYNC_ENABLED=true
IND_SCHEDULER_ENABLED=false
IND_SYNC_CRON=0 15 3 * * *

# AI Provider Configuration & API Keys
AI_ENABLED=true
AI_PROVIDER=gemini
AI_CONNECT_TIMEOUT_MS=10000
AI_READ_TIMEOUT_MS=75000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Job Search Autopilot & Notifications
AUTOPILOT_SCHEDULER_ENABLED=true
AUTOPILOT_CRON=0 15 */6 * * *
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_EMAIL_FROM=no-reply@eurojobcopilot.com

# OpenAPI / Swagger UI (keep false in prod)
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
