<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="040-create-job-assistant-messages-table" author="eurojob-architect">
        <comment>Create job_assistant_messages table for contextual AI Application Assistant conversation history and editable drafts</comment>
        <createTable tableName="job_assistant_messages">
            <column name="id" type="BIGINT UNSIGNED" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_job_assistant_messages" nullable="false"/>
            </column>
            <column name="uuid" type="CHAR(36)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_job_assistant_uuid"/>
            </column>
            <column name="user_id" type="BIGINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="job_id" type="BIGINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="action_type" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="user_prompt" type="TEXT"/>
            <column name="assistant_title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="assistant_content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="editable_content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="highlights_json" type="JSON"/>
            <column name="edited_by_user" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="ai_generated" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="ai_provider" type="VARCHAR(50)"/>
            <column name="ai_model_used" type="VARCHAR(100)"/>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="job_assistant_messages"
                                 baseColumnNames="user_id"
                                 constraintName="fk_job_assistant_user"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="job_assistant_messages"
                                 baseColumnNames="job_id"
                                 constraintName="fk_job_assistant_job"
                                 referencedTableName="jobs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <createIndex tableName="job_assistant_messages" indexName="idx_job_assistant_user_job">
            <column name="user_id"/>
            <column name="job_id"/>
            <column name="created_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="job_assistant_messages"/>
        </rollback>
    </changeSet>

    <changeSet id="041-extend-preferences-and-create-autopilot-logs" author="eurojob-architect">
        <comment>Add autopilot pause, email notification opt-in, last run timestamp to user_job_preferences and create autopilot_run_logs table</comment>
        <addColumn tableName="user_job_preferences">
            <column name="autopilot_paused" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="email_notifications_enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="last_autopilot_run_at" type="DATETIME"/>
        </addColumn>

        <createTable tableName="autopilot_run_logs">
            <column name="id" type="BIGINT UNSIGNED" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_autopilot_run_logs" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="trigger_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="ingestion_triggered" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="jobs_evaluated" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="new_matches_found" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="recommended_jobs_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="notifications_created" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="email_dispatched" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="summary_message" type="VARCHAR(500)"/>
            <column name="error_message" type="TEXT"/>
            <column name="started_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="DATETIME"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="autopilot_run_logs"
                                 baseColumnNames="user_id"
                                 constraintName="fk_autopilot_runs_user"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <createIndex tableName="autopilot_run_logs" indexName="idx_autopilot_runs_user_started">
            <column name="user_id"/>
            <column name="started_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="autopilot_run_logs"/>
            <dropColumn tableName="user_job_preferences" columnName="last_autopilot_run_at"/>
            <dropColumn tableName="user_job_preferences" columnName="email_notifications_enabled"/>
            <dropColumn tableName="user_job_preferences" columnName="autopilot_paused"/>
        </rollback>
    </changeSet>

    <changeSet id="042-extend-interview-prep-tables" author="eurojob-architect">
        <comment>Extend interview_prep_sessions and interview_questions with verified company prep topics, feedback arrays, ordering, and AI attribution</comment>
        <addColumn tableName="interview_prep_sessions">
            <column name="target_categories_json" type="JSON"/>
            <column name="target_difficulty" type="VARCHAR(30)" defaultValue="MID">
                <constraints nullable="false"/>
            </column>
            <column name="company_prep_topics_json" type="JSON"/>
            <column name="improvement_recommendations_json" type="JSON"/>
            <column name="ai_provider" type="VARCHAR(50)"/>
            <column name="ai_model_used" type="VARCHAR(100)"/>
        </addColumn>

        <addColumn tableName="interview_questions">
            <column name="order_index" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="focus_tags_json" type="JSON"/>
            <column name="strong_points_json" type="JSON"/>
            <column name="missing_elements_json" type="JSON"/>
            <column name="answered_at" type="DATETIME"/>
            <column name="evaluation_provider" type="VARCHAR(50)"/>
            <column name="evaluation_model_used" type="VARCHAR(100)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="interview_questions" columnName="evaluation_model_used"/>
            <dropColumn tableName="interview_questions" columnName="evaluation_provider"/>
            <dropColumn tableName="interview_questions" columnName="answered_at"/>
            <dropColumn tableName="interview_questions" columnName="missing_elements_json"/>
            <dropColumn tableName="interview_questions" columnName="strong_points_json"/>
            <dropColumn tableName="interview_questions" columnName="focus_tags_json"/>
            <dropColumn tableName="interview_questions" columnName="order_index"/>
            <dropColumn tableName="interview_prep_sessions" columnName="ai_model_used"/>
            <dropColumn tableName="interview_prep_sessions" columnName="ai_provider"/>
            <dropColumn tableName="interview_prep_sessions" columnName="improvement_recommendations_json"/>
            <dropColumn tableName="interview_prep_sessions" columnName="company_prep_topics_json"/>
            <dropColumn tableName="interview_prep_sessions" columnName="target_difficulty"/>
            <dropColumn tableName="interview_prep_sessions" columnName="target_categories_json"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

